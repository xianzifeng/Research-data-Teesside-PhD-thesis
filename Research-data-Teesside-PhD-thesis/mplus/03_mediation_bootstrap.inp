TITLE:   Bootstrap mediation (Table 5-4, Table 5-16; Section 4.6.1; Appendix C.3).
         5,000 bootstrap draws, bias-corrected percentile intervals
         (OUTPUT: CINTERVAL (BCBOOTSTRAP)).  Mplus 8.8.
         NOTE 1: Mplus does not allow BOOTSTRAP together with TYPE = COMPLEX or
         ESTIMATOR = MLR, so this run uses ESTIMATOR = ML without the cluster
         option (Section 4.6.1).  Cluster-robust point estimates come from
         02_sem_structural_mlr.inp; the employee-cluster bootstrap cross-check
         is implemented in code/04_bootstrap_mediation.py.
         NOTE 2: to report plain percentile intervals as well (Tibbe & Montoya,
         2022), re-run with CINTERVAL (BOOTSTRAP).

DATA:    FILE IS panel.dat;

VARIABLE:
  NAMES ARE emp unit wave et da
            a1 a2 a3 a4 a5 a6
            fa1 fa2 fa3 fa4 fa5
            drr1 drr2 drr3 drr4 trr1 trr2 trr3 trr4
            orr1 orr2 orr3 orr4 crr1 crr2 crr3 crr4
            ev1 ev2 ev3 psv1 psv2 psv3 cv1 cv2 cv3 div1 div2 div3
            js1 js2 js3 pr1 pr2 pr1xpr2 iv1 iv2 lnemp age ncomp lngdp;
  USEVARIABLES ARE fa1-fa5 drr1-drr4 trr1-trr4 orr1-orr4 crr1-crr4
                   ev1-ev3 psv1-psv3 cv1-cv3 div1-div3 pr1 pr2;
  MISSING ARE ALL (9999);

ANALYSIS:
  ESTIMATOR IS ML;
  BOOTSTRAP IS 5000;

MODEL:
  FA   BY fa1 fa2 fa3 fa4 fa5;
  DRR  BY drr1 drr2 drr3 drr4;   TRR BY trr1 trr2 trr3 trr4;
  ORR  BY orr1 orr2 orr3 orr4;   CRR BY crr1 crr2 crr3 crr4;
  EV   BY ev1 ev2 ev3;  PSV BY psv1 psv2 psv3;  CV BY cv1 cv2 cv3;  DIV BY div1 div2 div3;
  RR   BY DRR TRR ORR CRR;
  DC   BY EV PSV CV DIV;
  FA ON pr1 pr2;
  RR ON FA pr1 pr2;
  DC ON FA RR pr1 pr2;

MODEL INDIRECT:
  DC IND RR FA;                 ! H7: indirect, direct and total effect of FA on DC
  DC IND RR pr1;                ! H6: PR1 -> RR -> DC

OUTPUT:  STANDARDIZED (STDYX) CINTERVAL (BCBOOTSTRAP);
