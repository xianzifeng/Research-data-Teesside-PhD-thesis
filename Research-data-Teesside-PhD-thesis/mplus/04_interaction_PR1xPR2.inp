TITLE:   H10 - interaction of policy support (PR1) and compliance constraints (PR2)
         on Framework Adaptation (Table 5-13; Section 5.5.3).  Mplus 8.8.
         PR1 and PR2 are observed archival composites, so the product term is an
         observed variable (pr1xpr2, computed after standardisation in
         code/09_prepare_mplus_data.py).  Johnson-Neyman values are computed in
         code/06_moderation_interaction.py.

DATA:    FILE IS panel.dat;

VARIABLE:
  NAMES ARE emp unit wave et da
            a1 a2 a3 a4 a5 a6
            fa1 fa2 fa3 fa4 fa5
            drr1 drr2 drr3 drr4 trr1 trr2 trr3 trr4
            orr1 orr2 orr3 orr4 crr1 crr2 crr3 crr4
            ev1 ev2 ev3 psv1 psv2 psv3 cv1 cv2 cv3 div1 div2 div3
            js1 js2 js3 pr1 pr2 pr1xpr2 iv1 iv2 lnemp age ncomp lngdp;
  USEVARIABLES ARE fa1-fa5 drr1-drr4 trr1-trr4 orr1-orr4 crr1-crr4
                   ev1-ev3 psv1-psv3 cv1-cv3 div1-div3
                   pr1 pr2 pr1xpr2 lnemp age ncomp lngdp;
  MISSING ARE ALL (9999);
  CLUSTER IS emp;

ANALYSIS:
  TYPE IS COMPLEX;
  ESTIMATOR IS MLR;

MODEL:
  FA   BY fa1 fa2 fa3 fa4 fa5;
  DRR  BY drr1 drr2 drr3 drr4;   TRR BY trr1 trr2 trr3 trr4;
  ORR  BY orr1 orr2 orr3 orr4;   CRR BY crr1 crr2 crr3 crr4;
  EV   BY ev1 ev2 ev3;  PSV BY psv1 psv2 psv3;  CV BY cv1 cv2 cv3;  DIV BY div1 div2 div3;
  RR   BY DRR TRR ORR CRR;
  DC   BY EV PSV CV DIV;

  FA ON pr1 pr2 pr1xpr2 (b1 b2 b3)
        lnemp age ncomp lngdp;
  RR ON FA pr1 pr2 lnemp age ncomp lngdp;
  DC ON FA RR pr1 pr2 pr1xpr2 lnemp age ncomp lngdp;   ! H10b: interaction on DC

MODEL CONSTRAINT:
  NEW (slo_low slo_mean slo_high);
  slo_low  = b1 + b3 * (-1);   ! PR1 slope at PR2 = -1 SD
  slo_mean = b1;               ! at the mean
  slo_high = b1 + b3 * ( 1);   ! at +1 SD

OUTPUT:  STANDARDIZED (STDYX) CINTERVAL;
