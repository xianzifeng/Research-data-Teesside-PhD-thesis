TITLE:   Structural model - capability pathway PR -> FA -> RR -> DC
         (Table 5-3; H1-H5; Section 4.6.1).  Mplus 8.8, MLR, cluster-robust SEs.
         PR1 / PR2 enter as the archival composites of Section 4.5.1 (observed,
         standardised in code/09_prepare_mplus_data.py); the perception items
         a1-a6 are used in 01_cfa_measurement.inp.

DATA:    FILE IS panel.dat;

VARIABLE:
  NAMES ARE emp unit wave et da
            a1 a2 a3 a4 a5 a6
            fa1 fa2 fa3 fa4 fa5
            drr1 drr2 drr3 drr4 trr1 trr2 trr3 trr4
            orr1 orr2 orr3 orr4 crr1 crr2 crr3 crr4
            ev1 ev2 ev3 psv1 psv2 psv3 cv1 cv2 cv3 div1 div2 div3
            js1 js2 js3 pr1 pr2 pr1xpr2 iv1 iv2 lnemp age ncomp lngdp;
  USEVARIABLES ARE fa1-fa5 drr1-drr4 trr1-trr4 orr1-orr4 crr1-crr4
                   ev1-ev3 psv1-psv3 cv1-cv3 div1-div3
                   pr1 pr2 lnemp age ncomp lngdp;
  MISSING ARE ALL (9999);
  CLUSTER IS emp;

ANALYSIS:
  TYPE IS COMPLEX;
  ESTIMATOR IS MLR;

MODEL:
  FA   BY fa1 fa2 fa3 fa4 fa5;
  DRR  BY drr1 drr2 drr3 drr4;   TRR BY trr1 trr2 trr3 trr4;
  ORR  BY orr1 orr2 orr3 orr4;   CRR BY crr1 crr2 crr3 crr4;
  EV   BY ev1 ev2 ev3;  PSV BY psv1 psv2 psv3;  CV BY cv1 cv2 cv3;  DIV BY div1 div2 div3;
  RR   BY DRR TRR ORR CRR;
  DC   BY EV PSV CV DIV;

  ! structural part (controls of Section 4.5.6 on every endogenous construct)
  FA ON pr1 pr2                 lnemp age ncomp lngdp;   ! H3 (PR -> FA)
  RR ON FA pr1 pr2              lnemp age ncomp lngdp;   ! H4 (FA -> RR), PR -> RR
  DC ON FA RR pr1 pr2           lnemp age ncomp lngdp;   ! H2 (FA -> DC), H5 (RR -> DC), H1 (PR -> DC)

MODEL INDIRECT:
  DC IND RR FA;                 ! FA -> RR -> DC (H7)
  DC IND RR pr1;                ! PR1 -> RR -> DC (H6)
  DC IND FA pr1;                ! PR1 -> FA -> DC

OUTPUT:  STANDARDIZED (STDYX) CINTERVAL TECH1 TECH4;
