TITLE:   H8 / H9 - multi-group test of the capability pathway by Enterprise Type
         (Table 5-6).  For Data Attribute (Table 5-7) replace "GROUPING IS et"
         by "GROUPING IS da" and the group labels accordingly.  Mplus 8.8.
         Loadings are held equal across groups (Mplus default: metric
         invariance); structural paths are free in each group and the a-, b-
         and indirect effects are compared with MODEL CONSTRAINT / MODEL TEST
         (Section 4.6.1 item 5).

DATA:    FILE IS panel.dat;

VARIABLE:
  NAMES ARE emp unit wave et da
            a1 a2 a3 a4 a5 a6
            fa1 fa2 fa3 fa4 fa5
            drr1 drr2 drr3 drr4 trr1 trr2 trr3 trr4
            orr1 orr2 orr3 orr4 crr1 crr2 crr3 crr4
            ev1 ev2 ev3 psv1 psv2 psv3 cv1 cv2 cv3 div1 div2 div3
            js1 js2 js3 pr1 pr2 pr1xpr2 iv1 iv2 lnemp age ncomp lngdp;
  USEVARIABLES ARE fa1-fa5 drr1-drr4 trr1-trr4 orr1-orr4 crr1-crr4
                   ev1-ev3 psv1-psv3 cv1-cv3 div1-div3;
  MISSING ARE ALL (9999);
  CLUSTER IS emp;
  GROUPING IS et (0 = internal 1 = subsidiary);

ANALYSIS:
  TYPE IS COMPLEX;
  ESTIMATOR IS MLR;

MODEL:
  FA   BY fa1 fa2 fa3 fa4 fa5;
  DRR  BY drr1 drr2 drr3 drr4;   TRR BY trr1 trr2 trr3 trr4;
  ORR  BY orr1 orr2 orr3 orr4;   CRR BY crr1 crr2 crr3 crr4;
  EV   BY ev1 ev2 ev3;  PSV BY psv1 psv2 psv3;  CV BY cv1 cv2 cv3;  DIV BY div1 div2 div3;
  RR   BY DRR TRR ORR CRR;
  DC   BY EV PSV CV DIV;
  RR ON FA (a0);
  DC ON RR (b0);
  DC ON FA (c0);

MODEL subsidiary:
  RR ON FA (a1);
  DC ON RR (b1);
  DC ON FA (c1);

MODEL CONSTRAINT:
  NEW (ind0 ind1 diff);
  ind0 = a0 * b0;
  ind1 = a1 * b1;
  diff = ind1 - ind0;          ! Table 5-6: difference in indirect effects

MODEL TEST:
  a0 = a1;                     ! Wald test of equal a-paths (add b0 = b1 for a joint test)

OUTPUT:  STANDARDIZED (STDYX) CINTERVAL;
